# Docker-only settings. dev.ps1 creates .env and generates missing secrets.
COMPOSE_PROJECT_NAME=shad-tutoring
POSTGRES_USER=shad
POSTGRES_DB=shad_tutoring
POSTGRES_TEST_DB=shad_tutoring_test
POSTGRES_PASSWORD=__GENERATE__
CORE_JWT_SECRET=__GENERATE__
# Пояс, в котором записаны данные до перехода на UTC (нужен один раз миграции).
SHAD_TIMEZONE=Asia/Irkutsk
# 0.0.0.0 открывает сайт устройствам локальной сети (API и БД остаются на localhost)
SHAD_BIND=127.0.0.1
SHAD_HTTP_PORT=3000
SHAD_API_PORT=18080
SHAD_DB_PORT=15432
