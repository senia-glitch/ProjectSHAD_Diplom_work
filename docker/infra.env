# Public container defaults. URLs and credentials are supplied by Compose.
DB_SYNC_DRIVER=psycopg
LOG_LEVEL=INFO
CHANNELS=read,write,admin
READ_POOL_SIZE=5
READ_MAX_OVERFLOW=2
READ_QUEUE_MAXSIZE=1000
WRITE_POOL_SIZE=3
WRITE_MAX_OVERFLOW=2
WRITE_QUEUE_MAXSIZE=1000
ADMIN_POOL_SIZE=1
ADMIN_MAX_OVERFLOW=0
ADMIN_QUEUE_MAXSIZE=100
POOL_RECYCLE=1800
POOL_PRE_PING=True
POOL_TIMEOUT=30
DEFAULT_TIMEOUT=30.0
MAX_CONCURRENCY=100
SHUTDOWN_TIMEOUT=10.0
RETRY_MAX_RETRIES=3
RETRY_DELAY_SECONDS=0.5
RETRY_BACKOFF_MULTIPLIER=2.0
RETRY_MAX_TOTAL_TIMEOUT=0.0
RETRY_ON_TIMEOUT=false
CACHE_ENABLED=False
EXCLUDE_TABLES=alembic_version
