# Настройки сервера. deploy/deploy.sh init создаёт .env.production и генерирует секреты.
# Файл .env.production в git не попадает (.gitignore: .env.*).
COMPOSE_PROJECT_NAME=shad
POSTGRES_USER=shad
POSTGRES_DB=shad_tutoring
POSTGRES_TEST_DB=shad_tutoring_test
POSTGRES_PASSWORD=__GENERATE__
CORE_JWT_SECRET=__GENERATE__
# Часовой пояс сервера и БД (расписание хранит время сервера).
SHAD_TIMEZONE=Europe/Moscow

# Профиль https: Caddy выпускает сертификат для домена (DNS-запись A указывает на сервер, порты 80/443 открыты).
SHAD_DOMAIN=

# Без профиля https сайт слушает этот адрес; перед ним нужен свой обратный прокси с HTTPS.
SHAD_BIND=127.0.0.1
SHAD_HTTP_PORT=8080

# Доски: пусто — WebSocket принимается только с того же адреса, что и сайт.
BOARD_ALLOWED_ORIGINS=
BOARD_RETENTION_DAYS=365
BOARD_AUTOSAVE_MINUTES=2
